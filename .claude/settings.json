{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/home/.plugins-native/plugins/doubt/hooks/scripts/doubt-detector.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/home/.plugins-native/plugins/doubt/hooks/scripts/doubt-validator.sh"
          },
          {
            "type": "command",
            "command": "python3 /home/user/home/.plugins-native/plugins/say-summary/scripts/say-summary.py"
          }
        ]
      }
    ]
  }
}
