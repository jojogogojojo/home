# ChannelTalk Incoming Webhook URL
#
# 설정 방법:
#   1. 이 파일을 ~/.deploy-notify.env 로 복사 (repo 밖에 보관)
#   2. 아래 값을 실제 웹훅 URL로 교체
#   3. 이 원본 파일(.env.example)은 커밋해도 됩니다 — 실제 URL은 절대 커밋하지 마세요.
#
# ChannelTalk 웹훅 URL 발급:
#   ChannelTalk 관리자 콘솔 → 설정 → 팀 채팅 → Incoming Webhook → URL 복사
#
CHANNELTALK_WEBHOOK_URL=https://desk.channel.io/hooks/YOUR_WEBHOOK_TOKEN_HERE
