# ChannelTalk Open API Access Key
#
# 설정 방법:
#   1. 이 파일을 ~/.deploy-notify.env 로 복사 (repo 밖에 보관)
#   2. 아래 값을 실제 Access Key로 교체
#   3. 이 원본 파일(.env.example)은 커밋해도 됩니다 — 실제 키는 절대 커밋하지 마세요.
#
# Access Key 발급:
#   ChannelTalk 관리자 콘솔 → 설정 → 개발 → Open API → Access Key 생성
#
# 발송 대상 그룹: groups/356599 (SKILL.md에 하드코딩됨)
#
CHANNELTALK_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
